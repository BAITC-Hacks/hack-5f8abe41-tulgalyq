# Скопируйте в .env и вставьте НОВЫЙ ключ Google AI Studio после знака =.
# Не записывайте реальный ключ в этот шаблон, README, чат или Git.
# Если оставить строку пустой, сайт продолжит работать с локальными вопросами.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
